# Public site URL used for canonical links, sitemap, robots, llms.txt, and
# JSON-LD structured data. NEXT_PUBLIC_ vars are inlined at build time, so this
# is committed on purpose (it's a public value). Change it if the branded domain
# changes. Vercel's build (next build) loads this file automatically.
NEXT_PUBLIC_SITE_URL=https://dev-path-by-codewithowais.vercel.app
